# Run TypeScript type check
echo "Running TypeScript type check..."
bunx tsc --noEmit

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ TypeScript type check failed!"
  echo "Please fix the type errors before committing."
  echo "Run 'bunx tsc --noEmit' to see detailed errors."
  exit 1
fi

echo "✓ TypeScript type check passed"

# Run link checker on markdown files
echo ""
echo "Checking links in markdown files..."

# Find all markdown and HTML files, excluding ignored directories
CHECK_FILES=$(find . \( -name "*.md" -o -name "*.html" \) \
  -not -path "*/node_modules/*" \
  -not -path "*/.git/*" \
  -not -path "*/dist/*" \
  -not -path "*/build/*" \
  -not -path "*/conductor/archive/*" \
  2>/dev/null)

if [ -n "$CHECK_FILES" ]; then
  # Run markdown-link-check on all markdown and HTML files
  bunx markdown-link-check --config .markdown-link-check.json --quiet $CHECK_FILES
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Dead links detected!"
    echo "Please fix the broken links before committing."
    echo "Run 'bunx markdown-link-check --config .markdown-link-check.json <file>' to check individual files."
    exit 1
  fi
  
  echo "✓ All links are valid"
else
  echo "No markdown files found to check"
fi
