#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Validate commit message format
echo "Validating commit message format..."
bunx commitlint --edit "$1"

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Commit message validation failed!"
  echo ""
  echo "Valid commit message format: <type>(<scope>): <subject>"
  echo ""
  echo "Allowed types: feat, fix, docs, style, refactor, test, chore, conductor"
  echo ""
  echo "Examples:"
  echo "  feat(hooks): Add Husky integration"
  echo "  fix(types): Resolve TypeScript compilation errors"
  echo "  conductor(husky_20260728): Complete Phase 1"
  echo ""
  exit 1
fi

echo "✓ Commit message format is valid"
